{
  "name": "paramountcy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An India-only grand strategy game, 6000 BCE to 1947.",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.js\"",
