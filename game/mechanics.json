  "resources": {
    "treasury": {
      "label": "Treasury",
      "min": -999,
      "max": 999,
      "start": 20,
      "note": "Revenue net of spending. Goes negative; debt costs Legitimacy."
    },
    "grain": {
      "label": "Grain",
      "min": 0,
      "max": 100,
      "start": 50,
      "note": "Food security buffer. Zero plus a shock equals famine."
    },
    "labour": {
      "label": "Labour",
      "min": 0,
      "max": 100,
      "start": 50,
      "note": "Working population. Migration and mortality move it."
    },
    "artisanry": {
      "label": "Artisanry",
      "min": 0,
      "max": 100,
      "start": 30,
      "note": "Craft capacity. Slow to build, fast to lose, expensive to revive."
    },
    "literacy": {
      "label": "Literacy",
      "min": 0,
      "max": 100,
      "start": 10,
      "note": "The compounding resource. Pays nothing early."
    },
    "legitimacy": {
      "label": "Legitimacy",
      "min": 0,
      "max": 100,
      "start": 50,
      "note": "Consent to be governed. Gates what reforms you can attempt at all."
    },
    "infrastructure": {
      "label": "Infrastructure",
      "min": 0,
      "max": 100,
      "start": 15,
      "note": "Ports, canals, rail, power."
    },
    "unrest": {
      "label": "Unrest",
      "min": 0,
      "max": 20,
      "start": 2,
      "note": "Above 7 spawns insurgency; military action cannot clear it."
    },
    "water": {
      "label": "Water Table",
      "min": 0,
      "max": 100,
      "start": 80,
      "note": "Hidden until irrigation is built. Then visible, and falling."
    },
    "insight": {
      "label": "Insight",
      "min": 0,
      "max": 999,
      "start": 0,
      "note": "Earned by reading and answering Historia. The currency that unlocks build options."
    }
  },
