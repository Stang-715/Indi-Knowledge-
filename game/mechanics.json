  "scars": {
    "$comment": "Permanent modifiers. The point of a scar is that the player cannot buy their way out; they can only build around it. This is what makes history feel like history rather than a scoreboard.",
    "famine_memory": {
      "legitimacy_cap": -10,
      "note": "Legitimacy can never again reach 100 in this state."
    },
    "craft_lost": {
      "artisanry_regrowth": 0.33,
      "note": "Artisanry rebuilds at a third of normal rate; the tradition itself needs a Revival project."
    },
    "insurgency_zone": {
      "build_locked": true,
      "note": "District closed to building until cleared by Accord."
    },
    "severed_border": {
      "adjacency_deleted": true,
      "note": "Trade adjacency through the border is gone permanently."
    },
    "external_dependency": {
      "volatility": 0.25,
      "note": "Treasury swings with a foreign economy you do not control."
    }
  },
  "insight_economy": {
    "$comment": "How reading Historia converts into the power to act. This is the hybrid the design turns on: knowledge is literally the build currency.",
    "read_event": 1,
    "read_full_era": 8,
    "quiz_correct": {
      "easy": 2,
      "medium": 4,
      "hard": 7,
      "expert": 12
    },
    "quiz_wrong": 0,
    "identify_pattern_before_it_fires": 25,
    "costs": {
      "unlock_era_build_tree": 40,
      "unlock_craft_revival": 60,
      "preview_next_scenario_card": 15,
      "consult_the_record": 10
    }
  },
  "turn": {
    "$comment": "Turn length follows the era's own resolution, so ancient play is broad and modern play is granular -- the tempo of the game teaches the shape of the record.",
    "span_from_era": true,
    "phases": [
      "Historia (read)",
      "Decide",
      "Resolve",
      "Consequence",
      "Omen"
    ]
  },
  "recovery": {
    "$comment": "Per-year drift applied between events. Without it every shock ratchets and the whole simulation pins at its bounds within a century -- history has recovery, and a model that only accumulates damage is not a model of history. Rates are per year and applied over the gap between consecutive events. Rates are deliberately slow: a state that starved in 1770 should still read differently in 1900. Fast recovery erases exactly the history this game is about.",
    "labour": {
      "rate": 0.02,
      "toward": 60,
      "note": "Population recovers from famine and war over decades."
    },
    "unrest": {
      "rate": 0.025,
      "toward": 1,
      "note": "Grievance fades if nothing renews it. Scars slow this."
    },
    "grain": {
      "rate": 0.05,
      "toward": 50,
      "note": "Harvests resume."
    },
    "legitimacy": {
      "rate": 0.012,
      "toward": 45,
      "note": "Regimes normalise; consent drifts to a mediocre baseline."
    },
    "water": {
      "rate": 0.006,
      "toward": 80,
      "note": "Aquifers recharge, slowly, and only if not being drawn down."
    },
    "treasury": {
      "rate": 0.008,
      "toward": 25,
      "note": "Ordinary revenue and ordinary spending pull toward subsistence."
    },
    "scar_damping": {
      "insurgency_zone": {
        "unrest": 0.25
      },
      "famine_memory": {
        "legitimacy": 0.5
      }
    }
  }
