{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indi-knowledge/schema/historia.schema.json",
  "title": "Historia State Timeline",
  "description": "One file per state/UT. The right-hand rail in the Historia view renders `events` grouped by category, scrubbed by year.",
  "type": "object",
  "required": ["state_id", "schema_version", "events"],
  "properties": {
    "state_id": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "coverage": {
      "type": "object",
      "description": "Which eras have been ingested and how densely. Drives the 'gaps' overlay in the UI so players see where history is thin rather than assuming nothing happened.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "event_count": { "type": "integer" },
          "mean_confidence": { "type": "number" },
          "gap_years": { "type": "array", "items": { "type": "integer" } }
        }
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["id", "year", "era", "category", "title", "confidence", "sources"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.-?\\d{1,5}\\.[a-z_]+\\.[a-z0-9]{6}$",
          "description": "state.year.category.hash6 -- deterministic, so re-ingest is idempotent and never duplicates."
        },
        "year": { "type": "integer", "minimum": -7000, "maximum": 2100, "description": "Negative = BCE. For era-resolution events, the representative midpoint." },
        "year_end": { "type": ["integer", "null"], "description": "Set for spans (a war, a famine, a dynasty). Null for point events." },
        "year_precision": { "enum": ["exact", "decade", "quarter_century", "century", "era"] },
        "era": { "type": "string", "description": "era.* id from eras.json" },
        "category": { "enum": ["war", "legislature", "craft", "highlight", "development", "culture", "disaster", "movement"] },
        "title": { "type": "string", "maxLength": 140 },
        "summary": { "type": "string", "maxLength": 900, "description": "Player-facing prose shown in the rail." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Controlled vocabulary from taxonomy.json. The pattern engine matches ONLY on these." },
        "places": { "type": "array", "items": { "type": "string" } },
        "actors": { "type": "array", "items": { "type": "string" }, "description": "People, dynasties, parties, institutions." },
        "magnitude": {
          "type": ["number", "null"],
          "minimum": 0, "maximum": 1,
          "description": "Normalised impact on this state. Drives sim shock size and how prominently the rail surfaces it."
        },
        "causes": { "type": "array", "items": { "type": "string" }, "description": "Event ids this event is caused by. Populated by the linker, reviewable by a human." },
        "effects": { "type": "array", "items": { "type": "string" }, "description": "Event ids caused by this one." },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "review": {
          "type": "object",
          "properties": {
            "status": { "enum": ["auto", "flagged", "human_verified", "rejected"] },
            "flags": { "type": "array", "items": { "enum": ["low_confidence", "date_conflict", "source_conflict", "contested_history", "single_source", "attribution_unclear", "sensitive"] } },
            "note": { "type": "string" },
            "reviewer": { "type": ["string", "null"] }
          }
        },
        "contested": {
          "type": "boolean",
          "default": false,
          "description": "Historians genuinely disagree. Such events are shown with both readings in the rail and are NEVER used as quiz answers."
        },
        "sim": {
          "type": "object",
          "description": "How this event lands in the state-builder. Authored or derived from tags via mechanics.json.",
          "properties": {
            "channel": { "enum": ["military", "governance", "artisanry", "narrative", "economy", "legitimacy", "resilience", "unrest"] },
            "deltas": { "type": "object", "additionalProperties": { "type": "number" } },
            "scenario": { "type": ["string", "null"], "description": "Scenario card id if this event is playable as a decision." }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "enum": ["wikipedia", "wikidata", "gazetteer", "census", "data_gov_in", "pib", "archive_org", "state_portal", "book", "journal", "authored"] },
              "ref": { "type": "string" },
              "retrieved": { "type": ["string", "null"] },
              "license": { "type": ["string", "null"] },
              "quote": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
